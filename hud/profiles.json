{
  "autoHideMs": 9000,
  "defaultProfile": "B",
  "hotkeys": {
    "toggle": "Ctrl+Alt+K",
    "cycleProfile": "Ctrl+Alt+P",
    "showBoth": "Ctrl+Alt+Shift+K"
  },
  "profiles": [
    {
      "id": "A",
      "title": "TOOLS / AUTH",
      "keys": {
        "1": { "action": "COPY" },
        "2": { "action": "PASTE + NEW LINE" },
        "3": { "action": "CUT" },
        "4": { "action": "UNDO" },
        "5": { "action": "REDO" },
        "6": { "action": "SELECT ALL" },
        "7": { "action": "ОТЧЕТ" },
        "8": { "action": "ВОТ ОТЧЕТ" },
        "9": { "action": "```" },
        "0": { "action": "ОТЧЕТ ИЗ БУФЕРА" },
        ".": { "action": "ДАЙ СТАТУС" },
        "Enter": { "action": "НОВАЯ СТРОКА", "accent": "flow" },
        "-": { "action": "СТОП", "accent": "flow" },
        "+": { "action": "ОТЧЕТ ДЛЯ СЛЕД. ЧАТА" },
        "Space": { "action": "ПОДТВЕРЖДАЮ", "accent": "primary" },
        "Joystick": { "action": "ОТПРАВИТЬ", "accent": "send" }
      }
    },
    {
      "id": "B",
      "title": "MAIN / VIBECODING",
      "keys": {
        "1": { "action": "ПРОВЕРЬ" },
        "2": { "action": "СЛЕДУЮЩИЙ ШАГ" },
        "3": { "action": "СЛЕД. ПРОМПТ" },
        "4": { "action": "ИСПРАВЛЯЙ" },
        "5": { "action": "ПУБЛИКУЙ" },
        "6": { "action": "МЕРЖИ" },
        "7": { "action": "СОЗДАВАЙ" },
        "8": { "action": "ПРОДОЛЖАЙ" },
        "9": { "action": "РЕВЬЮ" },
        "0": { "action": "ГОТОВО" },
        ".": { "action": "ДАЙ СТАТУС" },
        "Enter": { "action": "НОВАЯ СТРОКА", "accent": "flow" },
        "-": { "action": "СТОП", "accent": "flow" },
        "+": { "action": "ОТЧЕТ ДЛЯ СЛЕД. ЧАТА" },
        "Space": { "action": "ДАВАЙ ДАЛЬШЕ БЕЗ PUSH/MERGE", "accent": "primary" },
        "Joystick": { "action": "ОТПРАВИТЬ", "accent": "send" }
      }
    }
  ]
}
