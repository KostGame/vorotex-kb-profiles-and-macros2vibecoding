<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Vorotex.K15.StatusTray</AssemblyName>
    <RootNamespace>Vorotex.K15.StatusLab</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling apps and developer tools under status-lab are isolated projects, not Status Tray sources. -->
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="lighting-lab\**\*.cs" />
    <Compile Remove="sleep-sweep\**\*.cs" />
    <Compile Remove="vendor-static-lab\**\*.cs" />
    <Compile Remove="control-center\**\*.cs" />
    <Compile Remove="hid-research-lab\**\*.cs" />
    <Compile Remove="hid-research-cli\**\*.cs" />
    <Compile Remove="StatusLabApplicationContext.cs" />
    <Compile Remove="ControlCenterForm.cs" />
    <Compile Remove="DeviceSettingsResearch.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <EmbeddedResource Remove="lighting-lab\**\*" />
    <EmbeddedResource Remove="sleep-sweep\**\*" />
    <EmbeddedResource Remove="vendor-static-lab\**\*" />
    <EmbeddedResource Remove="control-center\**\*" />
    <EmbeddedResource Remove="hid-research-lab\**\*" />
    <EmbeddedResource Remove="hid-research-cli\**\*" />
    <None Remove="tests\**\*" />
    <None Remove="lighting-lab\**\*" />
    <None Remove="sleep-sweep\**\*" />
    <None Remove="vendor-static-lab\**\*" />
    <None Remove="control-center\**\*" />
    <None Remove="hid-research-lab\**\*" />
    <None Remove="hid-research-cli\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="codex-hook-logger.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="install-codex-hooks.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="status-lab-config.example.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="configurator\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
