<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Vorotex.K15.StatusTray</AssemblyName>
    <RootNamespace>Vorotex.K15.StatusLab</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <K15BuildVersion Condition="'$(K15BuildVersion)' == ''">UNKNOWN</K15BuildVersion>
    <K15BuildCommit Condition="'$(K15BuildCommit)' == ''">UNKNOWN</K15BuildCommit>
    <K15BuildChannel Condition="'$(K15BuildChannel)' == ''">unknown</K15BuildChannel>
    <K15CanaryIssue Condition="'$(K15CanaryIssue)' == ''"></K15CanaryIssue>
    <K15CanaryPullRequest Condition="'$(K15CanaryPullRequest)' == ''"></K15CanaryPullRequest>
    <K15BuildUtc Condition="'$(K15BuildUtc)' == ''">UNKNOWN</K15BuildUtc>
    <K15BuildSourceRef Condition="'$(K15BuildSourceRef)' == ''"></K15BuildSourceRef>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="K15.Build.Version" Value="$(K15BuildVersion)" />
    <AssemblyMetadata Include="K15.Build.Commit" Value="$(K15BuildCommit)" />
    <AssemblyMetadata Include="K15.Build.Channel" Value="$(K15BuildChannel)" />
    <AssemblyMetadata Include="K15.Build.CanaryIssue" Value="$(K15CanaryIssue)" />
    <AssemblyMetadata Include="K15.Build.CanaryPullRequest" Value="$(K15CanaryPullRequest)" />
    <AssemblyMetadata Include="K15.Build.BuildUtc" Value="$(K15BuildUtc)" />
    <AssemblyMetadata Include="K15.Build.SourceRef" Value="$(K15BuildSourceRef)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sibling apps and developer tools under status-lab are isolated projects, not Status Tray sources. -->
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="lighting-lab\**\*.cs" />
    <Compile Remove="sleep-sweep\**\*.cs" />
    <Compile Remove="vendor-static-lab\**\*.cs" />
    <Compile Remove="control-center\**\*.cs" />
    <Compile Remove="hid-research-lab\**\*.cs" />
    <Compile Remove="hid-research-cli\**\*.cs" />
    <Compile Remove="visual-test-rig\**\*.cs" />
    <Compile Remove="research\**\*.cs" />
    <Compile Remove="live-dashboard\**\*.cs" />
    <Compile Remove="StatusLabApplicationContext.cs" />
    <Compile Remove="ControlCenterForm.cs" />
    <Compile Remove="DeviceSettingsResearch.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <EmbeddedResource Remove="lighting-lab\**\*" />
    <EmbeddedResource Remove="sleep-sweep\**\*" />
    <EmbeddedResource Remove="vendor-static-lab\**\*" />
    <EmbeddedResource Remove="control-center\**\*" />
    <EmbeddedResource Remove="hid-research-lab\**\*" />
    <EmbeddedResource Remove="hid-research-cli\**\*" />
    <EmbeddedResource Remove="visual-test-rig\**\*" />
    <EmbeddedResource Remove="research\**\*" />
    <None Remove="tests\**\*" />
    <None Remove="lighting-lab\**\*" />
    <None Remove="sleep-sweep\**\*" />
    <None Remove="vendor-static-lab\**\*" />
    <None Remove="control-center\**\*" />
    <None Remove="hid-research-lab\**\*" />
    <None Remove="hid-research-cli\**\*" />
    <None Remove="visual-test-rig\**\*" />
    <None Remove="research\**\*" />
    <None Remove="live-dashboard\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="codex-hook-logger.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="install-codex-hooks.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="status-lab-config.example.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="configurator\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
